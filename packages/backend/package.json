    "@types/node": "^26.5.0",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^15.15.0",
    "jest": "^30.5.2",
