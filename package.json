{
    "name": "code-quality-testing-evaluation",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
      "packages/*"
    ],
    "scripts": {
        "start": "npm run build --workspace=backend && concurrently \"npm run start --workspace=backend\" \"npm run start --workspace=frontend\"",
        "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run start --workspace=frontend\"",
        "build": "npm run build --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present"
    },
    "devDependencies": {
      "concurrently": "^8.2.2"
    }
}
