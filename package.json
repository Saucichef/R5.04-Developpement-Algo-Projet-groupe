{
  "name": "code-quality-testing-evaluation",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "concurrently \"npm run start --workspace=backend\" \"npm run start --workspace=frontend\"",
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run start --workspace=frontend\"",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prepare": "husky",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "build": "npm run build --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  },
  "lint-staged": {
    "packages/frontend/**/*.{js,jsx,ts,tsx}": [
      "npm exec --workspace=frontend -- eslint --fix",
      "npm exec --workspace=frontend -- prettier --write",
      "npm exec --workspace=frontend -- react-scripts test --watchAll=false --findRelatedTests --passWithNoTests"
    ],
    "packages/backend/**/*.{js,jsx,ts,tsx}": [
      "npm exec --workspace=backend -- eslint --fix",
      "npm exec --workspace=backend -- prettier --write",
      "npm exec --workspace=backend -- jest --config jest.config.js --findRelatedTests --passWithNoTests"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  }
}
